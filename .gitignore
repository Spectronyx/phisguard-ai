# =============================================================================
# PhishGuard AI — .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
MANIFEST
.eggs/

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
coverage.xml
*.cover
nosetests.xml
pytest.xml

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pyright/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# -----------------------------------------------------------------------------
# ML Artifacts (generated by training scripts — not source)
# -----------------------------------------------------------------------------
backend/artifacts/*.joblib
backend/artifacts/*.pkl
backend/artifacts/*.bin
backend/artifacts/*.pt
backend/artifacts/*.pth
backend/artifacts/*.h5
backend/artifacts/local_llm/
# Keep the directory itself tracked
!backend/artifacts/.gitkeep

# Metrics and graph metadata are small JSON files — keep them
# backend/artifacts/metrics.json        → tracked
# backend/artifacts/graph_metadata.json → tracked
# backend/artifacts/local_llm_metrics.json → tracked

# -----------------------------------------------------------------------------
# Datasets (downloaded/generated — often large binary/csv files)
# -----------------------------------------------------------------------------
backend/datasets/raw/
backend/datasets/processed/
# Keep directory structure
!backend/datasets/raw/.gitkeep
!backend/datasets/processed/.gitkeep

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
backend/phishguard.db
backend/phishguard.db-journal
backend/phishguard.db-wal
backend/phishguard.db-shm
*.sqlite
*.sqlite3
*.db

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.env
frontend/.env.local
frontend/.env.*.local

# -----------------------------------------------------------------------------
# Environment & Secrets — NEVER commit these
# -----------------------------------------------------------------------------
.env
.env.local
.env.development
.env.production
.env.staging
.env.test
*.pem
*.key
*.cert
*.p12
secrets/

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
*.log
logs/
*.out

# -----------------------------------------------------------------------------
# OS & Editor files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# JetBrains / PyCharm
.idea/
*.iml
*.iws
*.ipr

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.\#*

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
newfile.txt
*.tmp
*.temp
*.bak
*.orig
.cache/
