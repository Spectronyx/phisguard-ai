# ---- Core ---------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=sqlite:///backend/phishguard.db

# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Directory containing joblib/pickle artifacts (relative to backend/ or absolute).
ARTIFACTS_DIR=artifacts

# ---- Local LLM (private, on-machine) -------------------------------------
# Fine-tuned DistilBERT semantic classifier. Enabled by default; it never sends
# email content off-machine. Requires: pip install -r backend/requirements-llm.txt
# Train with: python backend/scripts/train_local_llm.py
LOCAL_LLM_ENABLED=true
LOCAL_LLM_MAX_LENGTH=384
# auto | cpu | cuda
LOCAL_LLM_DEVICE=auto

# ---- Optional EXTERNAL LLM fallback --------------------------------------
# Disabled by default. Only used when the local model is unavailable and BOTH
# LLM_ENABLED=true and LLM_API_KEY are set. Never commit a real key.
LLM_ENABLED=false
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=12
LLM_MAX_TOKENS=600

# ---- Risk engine (defaults shown) ---------------------------------------
WEIGHT_EMAIL_MODEL=0.30
WEIGHT_URL_MODEL=0.30
WEIGHT_EMAIL_RULES=0.15
WEIGHT_URL_RULES=0.10
WEIGHT_GRAPH=0.05
WEIGHT_LLM=0.10
THRESHOLD_SUSPICIOUS=30
THRESHOLD_HIGH=60
THRESHOLD_CRITICAL=80

# Popularity calibration factor for bare top-ranked domains (1.0 disables).
URL_POPULARITY_CALIBRATION=0.3
